{
    // command : {name, command, time (optional), bufferTime (optional)}
    // name : name of the command
    // command : command sequence
    // time : time to execute the command in frames (optional, default is 15)
    // bufferTime : time to keep the executed command in buffer in frames (optional, default is 1)
